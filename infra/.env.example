# Copy this file to .env on the deployment machine and replace every value.
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_HOSTNAME=finanzapp.ddns.net
USER_DB_PASSWORD=replace-with-a-long-random-password
MOVEMENTS_DB_PASSWORD=replace-with-a-long-random-password
TAGS_DB_PASSWORD=replace-with-a-long-random-password
HOME_DB_PASSWORD=replace-with-a-long-random-password
CONNECTIONS_DB_PASSWORD=replace-with-a-long-random-password
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_DRY_RUN=false
MONTHLY_REPORT_TEST_ENDPOINT_ENABLED=false
MONTHLY_REPORT_TIME_ZONE=Europe/Madrid
MONTHLY_REPORT_CRON=0 0 8 * * *
BREVO_FROM_EMAIL=notificaciones@tu-dominio.com
BREVO_FROM_NAME=LifeHub
BREVO_API_KEY=replace-with-brevo-api-key
